<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 항상 밝은 화면 (다크모드 자동 반전 끔) -->
    <style name="Theme.GongsuCalendar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryDark">@color/brand_green_dark</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="android:statusBarColor">@color/brand_green_dark</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- 크기(width/height)는 style이 아니라 layout 파일에 직접 적어서 오류를 막음 -->
    <style name="WeekdayLabel">
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#333333</item>
    </style>

    <style name="GongsuPresetButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="StepperButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="cornerRadius">4dp</item>
    </style>
</resources>
