<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GongsuCalendar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryDark">@color/brand_green_dark</item>
        <item name="colorAccent">@color/brand_green</item>
        <item name="android:statusBarColor">@color/brand_green_dark</item>
    </style>

    <style name="GongsuPresetButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_margin">2dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="WeekdayLabel">
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#333333</item>
    </style>

    <style name="DrawerSectionTitle">
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">#888888</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DrawerItem">
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#222222</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="StepperButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:backgroundTint">#2196F3</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">4dp</item>
    </style>
</resources>
